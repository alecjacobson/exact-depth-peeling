    "libmpfr-dev": "4.1.0-3build3",
    "libboost-dev": "1.74.0.3ubuntu7",
    "nlohmann-json3-dev": "3.10.5-2"
  },
  "cgal": {
    "tag": "v5.4",
    "upstream_commit": "c58ac97e93c838ebfb1e8adaf23ff4fd185dc8e4",
    "source": "https://github.com/CGAL/cgal",
    "installed_from": "Ubuntu package libcgal-dev 5.4-1",
    "documentation_reference": "6.2",
    "api_adaptations": "Use 5.4 hole iterators and exact CDT; classify labelled faces directly rather than mark_domain_in_triangulation."
  },
  "vectorizer_reference": {
    "repository": "https://github.com/MangoSister/vectorizer2-archive",
