  "compiler": "g++ (Ubuntu 11.4.0-1ubuntu1~22.04.3) 11.4.0",
  "cmake": "cmake version 4.4.0",
  "python": "3.10.12",
  "matplotlib": "3.10.9",
  "openmp": {
    "optional": true,
    "implementation": "GCC libgomp",
    "compiler_flag": "-fopenmp",
    "benchmark_threads": 4
  },
  "large_mesh_render": {
    "blender": "4.5.3",
    "Pillow": "12.3.0",
    "optional": true,
    "used_for": "Rendering actual exported geometry only; outside extraction timings"
  },
  "arithmetic": {
    "default": "CGAL::Lazy_exact_nt<CGAL::Exact_rational>",
    "eager_build_option": "-DPEEL_LAZY_EXACT=OFF",
    "construction_semantics": "exact in both configurations"
  },
  "intersection_preprocessor": {
    "implementation": "CGAL 5.4 PMP experimental::autorefine",
    "constructions": "exact rational",
    "source_incorporated": false,
    "input_contract": "consistently oriented manifold with optional boundary; positive-area coincident surfaces unsupported"
  },
  "dragon_render": {
    "blender": "4.5.3",
    "engine": "Cycles / OptiX",
    "gpu": "NVIDIA L40",
    "numpy": "2.2.6",
    "scipy": "1.15.0",
    "opencv": "5.0.0",
    "Pillow": "12.3.0",
    "optional": true,
    "used_for": "lossless export packing, display-resolution outlines, Blender rendering and GIF encoding; excluded from solver timings"
  },
  "dragon_decimation": {
    "blender": "4.5.3 LTS",
    "modifier": "Decimate COLLAPSE with triangulation",
    "input_coordinate_storage": "float32",
    "independent_levels": true,
    "camera": "fixed full-dragon camera",
    "intersection_preprocessing": "exact CGAL autorefinement per cached level",
    "used_for": "cached benchmark inputs, outside extraction timings"
  },
  "warp_gpu": {
    "optional": true,
    "warp-lang": "1.15.0",
    "numpy": "2.2.6",
    "test_pytest": "9.1.1",
    "test_shapely": "2.1.2",
    "gpu": "NVIDIA L40",
    "driver": "570.158.01",
    "cuda_driver": "12.8",
    "minimum_conditional_graph_cuda_driver": "12.4",
    "arithmetic": "binary64 geometry, padded binary32 BVHs; approximate, not the CPU exact kernel",
    "implementation": "Warp kernels and Warp GPU radix primitives; no custom native extension"
  }
